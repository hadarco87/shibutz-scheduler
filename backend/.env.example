# Backend (copy to backend/.env for local overrides)
ENVIRONMENT=development
SEED_DEMO=true
SECRET_KEY=dev-secret-change-me-in-production
DATABASE_URL=sqlite:///./shibutz.db
CORS_ORIGINS=http://localhost:3000

# Production example:
# ENVIRONMENT=production
# SEED_DEMO=false
# SECRET_KEY=<long-random>
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/shibutz
# CORS_ORIGINS=https://your-app.vercel.app,https://shibutz.example.com
